{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseInitialization": {
    "MaxAttempts": 20,
    "DelaySeconds": 3
  },
  "FeatureHub": {
    "EdgeUrl": "http://localhost:8085",
    "SdkKey": "YOUR_FEATUREHUB_SDK_KEY",
    "FeatureKey": "SubscriberServiceEnabled",
    "RetrySeconds": 5
  },
  "SubscriberQueue": {
    "HostName": "localhost",
    "Port": 5673,
    "UserName": "application",
    "Password": "YOUR_PASSWORD"
  },
  "ConnectionStrings": {
    "SubscriberService": "Server=localhost,1439;Database=Subscribers;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False"
  }
}
