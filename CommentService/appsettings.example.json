{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseInitialization": {
    "MaxAttempts": 20,
    "DelaySeconds": 3
  },
  "ConnectionStrings": {
    "CommentService": "Server=localhost,1435;Database=Comments;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False"
  },
  "ProfanityService": {
    "BaseUrl": "http://localhost:5050",
    "TimeoutSeconds": 2,
    "FailureThreshold": 3,
    "BreakDurationSeconds": 30
  }
}
