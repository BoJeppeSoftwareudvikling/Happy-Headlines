@ArticleService_HostAddress = http://127.0.0.1:8080
@GlobalArticleId = 1

GET {{ArticleService_HostAddress}}/Article?continent=Europe
Accept: application/json

###

GET {{ArticleService_HostAddress}}/Article/recent?continent=Global&limit=10
Accept: application/json

###

GET {{ArticleService_HostAddress}}/Article/{{GlobalArticleId}}?continent=Global
Accept: application/json

### Repeat to demonstrate an ArticleCache hit

GET {{ArticleService_HostAddress}}/Article/{{GlobalArticleId}}?continent=Global
Accept: application/json

###

PUT {{ArticleService_HostAddress}}/Article/{{GlobalArticleId}}?continent=Global
Content-Type: application/json

{
  "title": "Updated global headline",
  "content": "This update invalidates the active cache entry.",
  "continent": "Global"
}

### The update makes this a cache miss with database fallback

GET {{ArticleService_HostAddress}}/Article/{{GlobalArticleId}}?continent=Global
Accept: application/json

###

GET {{ArticleService_HostAddress}}/metrics
